# Copy to .env (or run ./scripts/init-env.sh, which also generates random secrets).
# .env contains secrets: keep it out of version control and readable only by you (chmod 600).

COMPOSE_PROJECT_NAME=typo3

# --- Versions -------------------------------------------------------------
TYPO3_VERSION=^13.4
PHP_VERSION=8.3

# --- Host integration -----------------------------------------------------
# UID/GID PHP runs as, so ./app stays editable on the host (use `id -u` / `id -g`)
HOST_UID=1000
HOST_GID=1000
# 127.0.0.1 = only reachable from this machine; use 0.0.0.0 to publish on all interfaces
BIND_ADDRESS=127.0.0.1
HTTP_PORT=8080
PMA_PORT=8081

# --- Database -------------------------------------------------------------
DB_NAME=typo3
DB_USER=typo3
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too

# --- TYPO3 ----------------------------------------------------------------
# Production | Development | Development/Local ...
TYPO3_CONTEXT=Production
TYPO3_TRUSTED_HOSTS_PATTERN=localhost(:[0-9]+)?
TYPO3_BASE_URL=http://localhost:8080/
TYPO3_PROJECT_NAME=TYPO3

# First start only: automatic `typo3 setup`. Password needs upper, lower, digit and special char.
# Remove TYPO3_ADMIN_PASSWORD from .env once the site is installed.
TYPO3_AUTO_SETUP=1
TYPO3_ADMIN_USER=admin
TYPO3_ADMIN_PASSWORD=
TYPO3_ADMIN_EMAIL=admin@example.com